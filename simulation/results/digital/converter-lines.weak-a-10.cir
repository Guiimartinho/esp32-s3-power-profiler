* Acquisition frame at 15 MHz, weak pad: converter slow, registers fast
.include "../../models/digital.lib"
C92 v3c 0 1e-06
C98 v3c 0 1e-07
C99 v3c 0 1e-07
RRN3_1 gp19 0 4700
RRN3_2 gp20 0 4700
RRN3_3 gp21 0 4700
RRN3_4 gp22 v3a 4700
RRN4_1 gp19 adc_sck 47
RRN4_2 gp20 adc_cnv 47
RRN4_3 gp21 side_load 47
RRN4_4 gp22 dac_cs_mid 47
RRN5_1 u30_sclk adc_sck 220
RRN5_2 u30_dout gp16 220
RRN5_3 u30_cnv adc_cnv 220
XU30 u30_cnv u30_dout u30_sclk v3c v3c 0 DIGITAL_ADS8860_IO code=43690 tdo=1.12e-08 cin=8e-12 cout=8e-12
XU33 side_load adc_sck din4 din5 din6 din7 nc_u33_q7_pad7 0 q33 v3c din0 din1 din2 din3 0 v3c DIGITAL_LV165A tclk=5e-11 tld=5e-11
XU34 side_load adc_sck vin_ov gate_out mux_a0 mux_a1 nc_u34_q7_pad7 0 q34 q33 pwr_good cmp_up cmp_jump cmp_oc 0 v3c DIGITAL_LV165A tclk=5e-11 tld=5e-11
R138 q34 gp17 33
* the 3.3 V rail of the module, an ideal source
Viovdd iovdd 0 3.3
* rails of the carrier as ideal sources
Vlogic v3c 0 3.3
Vanalog v3a 0 3.3
* three pads of the controller run the frame; two pads read
Xgp19 gp19 gp19_ctl gp19_oe iovdd 0 DIGITAL_RP2350_PAD roh=170 rol=125 cpad=8e-12 e9=0
Xgp20 gp20 gp20_ctl gp20_oe iovdd 0 DIGITAL_RP2350_PAD roh=170 rol=125 cpad=8e-12 e9=0
Xgp21 gp21 gp21_ctl gp21_oe iovdd 0 DIGITAL_RP2350_PAD roh=170 rol=125 cpad=8e-12 e9=0
Xgp16 gp16 gp16_ctl gp16_oe iovdd 0 DIGITAL_RP2350_PAD roh=170 rol=125 cpad=8e-12 e9=0
Xgp17 gp17 gp17_ctl gp17_oe iovdd 0 DIGITAL_RP2350_PAD roh=170 rol=125 cpad=8e-12 e9=0
