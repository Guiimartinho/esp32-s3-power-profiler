Vgp19_ctl gp19_ctl 0 PWL(0 0 8.86667e-07 0 8.86767e-07 1 9.2e-07 1 9.201e-07 0 9.53333e-07 0 9.53433e-07 1 9.86667e-07 1 9.86767e-07 0 1.02e-06 0 1.0201e-06 1 1.05333e-06 1 1.05343e-06 0 1.08667e-06 0 1.08677e-06 1 1.12e-06 1 1.1201e-06 0 1.15333e-06 0 1.15343e-06 1 1.18667e-06 1 1.18677e-06 0 1.22e-06 0 1.2201e-06 1 1.25333e-06 1 1.25343e-06 0 1.28667e-06 0 1.28677e-06 1 1.32e-06 1 1.3201e-06 0 1.35333e-06 0 1.35343e-06 1 1.38667e-06 1 1.38677e-06 0 1.42e-06 0 1.4201e-06 1 1.45333e-06 1 1.45343e-06 0 1.48667e-06 0 1.48677e-06 1 1.52e-06 1 1.5201e-06 0 1.55333e-06 0 1.55343e-06 1 1.58667e-06 1 1.58677e-06 0 1.62e-06 0 1.6201e-06 1 1.65333e-06 1 1.65343e-06 0 1.68667e-06 0 1.68677e-06 1 1.72e-06 1 1.7201e-06 0 1.75333e-06 0 1.75343e-06 1 1.78667e-06 1 1.78677e-06 0 1.82e-06 0 1.8201e-06 1 1.85333e-06 1 1.85343e-06 0 1.88667e-06 0 1.88677e-06 1 1.92e-06 1 1.9201e-06 0)
